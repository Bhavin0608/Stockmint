# Port to run the server on (Render sets this dynamically)
PORT=5000

# Environment mode: development or production
NODE_ENV=production

# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/stockmint?retryWrites=true&w=majority

# Secret key used for signing JWT access tokens
JWT_SECRET=your_jwt_secret_key_here_min_32_characters

# Frontend URL deployed on Vercel (for CORS & credentials)
CLIENT_URL=https://your-stockmint-frontend.vercel.app
